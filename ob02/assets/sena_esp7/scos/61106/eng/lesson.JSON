nt": "", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}], "id": 11, "type": "RSLT"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 1}], "_data": [{"contents": [{"content": "enpe7n3le03ob02re7pdf01.pdf", "type": "pdf"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [{"content": "I can find more information about error correction in transmitting data", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Take Away", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}], "type": "post_instructions"}], "id": 12, "type": "DWS"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "stimuli": [{"_data": [], "type": "welcome", "template_override": 1, "id": 0, "contents": [{}]}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "id": 1, "contents": [{"value": {"coverimg": "enpe7n3le03ob02re2img01.jpg", "images": [{"time": "0", "text": "<p style=\"text-align: justify;\"><b>Mathew:&nbsp;</b>Ok, Ann. We are about to finish programming the company&rsquo;s web-based software, but we must analyze some of the variables that are there so that we can choose the error correction method the program needs to protect the information while it is exchanging data.<br /><b>Ann</b>: You are right; remember that when we transmit data, errors are present in different ways during the process. For example, when the program is loading information from the web to store it in the cache of the computer; if there is a voltage drop, the electrical noise in the line can cause spurious bits or a bit flipping in the data stream. As a result, data errors in the disk occur.&nbsp;</p>", "id": 0, "image": "enpe7n3le03ob02re2img01.jpg"}, {"time": "45000", "text": "<p style=\"text-align: justify;\"><b>Mathew:&nbsp;</b>Of course, the simple coding of the program allows some wrong characters, but there are cases in which a large number of wrong characters become a problem for the program because they produce bugs and failures. That&rsquo;s why engineers in the company are developing techniques to ensure the correct transmission of data. But, is there any way to ensure that process?<br /><b>Ann:</b>&nbsp;Sure, there are some schemes, such as the parity one. There, programmers add an extra bit to a set of bytes of data so that the extra bit joins to one bit when the number is odd. When there is an error, one of the bits disappears, and the extra bit joins to fix the error.&nbsp;</p>", "id": 1, "image": "enpe7n3le03ob02re2img02.jpg"}, {"time": "90000", "text": "<p style=\"text-align: justify;\"><b>Mathew:&nbsp;</b>I know our programmers are implementing the checksum schema to correct errors, because it adds the binary value of each block of data, and sends them along with the block of information. Finally, when it reaches its destination, the program checks the data to see if they match.<br /><b>Ann</b>: Sure, but personally, I&rsquo;m using the Cyclical Redundancy Check method to avoid and correct errors, as it sends data to the program and divides the blocks into specific numbers, when the data reaches its destination the program joins and calculates them again.&nbsp;<br /><b>Mathew:&nbsp;</b>Do not forget we can also implement the Hamming Code to provide high reliability, as it also corrects errors automatically. This scheme encrypts data and bits together to generate a code word in the file to ensure that the file at its destination only opens with the same code word.</p>", "id": 2, "image": "enpe7n3le03ob02re2img03.jpg"}], "audiosrc": "enpe7n3le03ob02re2aud01"}, "type": "slideshow"}]}], "id": 0, "type": "scholar"}]}